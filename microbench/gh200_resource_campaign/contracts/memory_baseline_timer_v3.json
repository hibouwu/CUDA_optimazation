    "global_duplex": "both full-array write check and read checksum",
    "empty": "zero workload; validate timestamps and CTA record coverage only"
  },
  "formulas": {
    "shared_scalar8": "threads * 8 scalar accesses * 4 bytes * iterations * blocks; direction by mode",
    "global_vector16": "quantum=blocks*threads*16; allocation=ceil(requested_bytes/quantum)*quantum; reads/writes=allocation*iterations for enabled directions",
    "empty_window": "work=read=write=0; one_cta primary output local clock64 cycles/window; all_gpu primary output positive grid globaltimer ns/window; never subtract from payload windows"
  },
  "warmup": "8 to 30 same-allocation windows, last 5 CV<=0.02; all timing samples retained, no thermal-equilibrium assertion",
  "timing": "CTA globaltimer and local clock64; end CTA barrier; global stores include device fence; data initialization and result copies/validation excluded; timer revision: zero-work CTA ns may equal, local cycles must be positive; all_gpu grid ns must remain positive",
