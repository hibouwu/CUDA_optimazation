  "work_formula": "blocks*groups*chains*batch*iterations*2*M*N*K; signed/unsigned INT8 uses OP, floating FP8 uses FLOP",
  "timing": "operands/D0 prepared before thread0 start; CTA barrier after saved start; counted loop; WGMMA commit/wait0 per batch and final wait0; all results drained before end CTA barrier/stop",
  "correctness": {
    "formal": "uniform A=B=1/16 for FP8, 1 for INT8; D0=0, fresh launch each time; every output checked",
    "FP8_nonuniform": "A(m,k)=((m+2*k+seed)%7-3)/8; B(k,n)=((n+3*k+seed)%7-3)/8; D0=(1+group+chain)/8",
    "S8_nonuniform": "A(m,k)=(m+2*k+seed)%5-2; B(k,n)=(n+3*k+seed)%5-2; D0=1+group+chain",
    "U8_nonuniform": "A(m,k)=(m+2*k+seed)%3; B(k,n)=(n+3*k+seed)%3; D0=1+group+chain",
    "validation": "same specialized kernel with nonuniform values at iterations1/2; host integer dot-product reference independent of fragment packing; exact finite comparisons of all outputs; NaN/Inf reject; output poison",
    "not_claimed": "all values, nonfinite behavior, overflow, saturation and mixed input encodings are outside this representative contract"
  },
  "fragments": {
    "mma_A": {
      "elements_per_lane": 16,
      "row": "lane//4+8*((element//4)%2)",
      "col": "4*(lane%4)+element%4+16*(element//8)"
    },
    "mma_B": {
      "elements_per_lane": 8,
      "row": "4*(lane%4)+element%4+16*(element//4)",
      "col": "lane//4"
    },
    "mma_D": {
      "elements_per_lane": 4,
      "row": "lane//4+8*(element//2)",
      "col": "2*(lane%4)+element%2"
    },
    "wgmma_AB_smem": {
      "offset": "(outer%8)*16+(outer//8)*128+inner%16+(inner//16)*1024",
      "element_bytes": 1,
      "alignment_bytes": 128,
      "leading_offset_bytes": 1024,
      "stride_offset_bytes": 128,
      "swizzle": "none"
    },
    "wgmma_D": {
      "elements_per_thread": 32,
      "row": "16*(thread//32)+(thread%32)//4+8*((element//2)%2)",
      "col": "2*(thread%4)+element%2+8*(element//4)"
    }
  },
  "numerical_bounds": {
    "formal_products_per_output": 4194304,
    "FP8_formal_denominator": 256,
    "FP8_formal_integer_numerator_limit": 16777216,
    "INT8_formal_output": 4194304,
    "INT8_max_nonuniform_abs_product": 4,
    "signed_accumulation_limit": 2147483647
  },
  "sass_contracts": {
    "required": "instruction/shape/type-specific MMA/HGMMA in actual repeated timed control flow; no local spill, valid entry/drain barriers; vector lane packing and signedness validated by nonuniform outputs"
  },
  "claims": {
    "physical_peak": false,
    "cache_residency_proven": false,
    "physical_hbm_bytes_proven": false,
    "complete_precision_domain": false
  },
  "references": [
    "https://docs.nvidia.com/cuda/archive/12.9.1/parallel-thread-execution/index.html#warp-level-matrix-instructions-mma",
    "https://docs.nvidia.com/cuda/archive/12.9.1/parallel-thread-execution/index.html#asynchronous-warpgroup-level-matrix-instructions"
  ]
}
