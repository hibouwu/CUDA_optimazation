  "semantics": {
    "matrix_element": "raw uint16 bits; no floating arithmetic",
    "shared_layout": "8 slots of 512 bytes per array; each slot contains up to four row-major 8x8 uint16 matrices",
    "address_lane": "matrix=lane//8,row=lane%8; unused lanes repeat valid rows; row starts aligned16B",
    "fragment_normal": "register[matrix], low/high half e=0/1 holds row=lane//4,col=2*(lane%4)+e",
    "fragment_transpose": "register[matrix], low/high half e=0/1 holds row=2*(lane%4)+e,col=lane//4",
    "input_value": "uint16(1+row+11*col+97*matrix+997*slot+(seed%8191))",
    "load_loop": "each q loads slot q; accumulate all registers into per-lane unsigned checksum; final full-fragment snapshot plus checksum validated",
    "store_loop": "each q stores slot q with input coordinate value XOR uint16(iteration+1); final complete output array validated; no read in timed loop",
    "roundtrip_loop": "each q ldmatrix from input slot q then stmatrix into output slot q, same transpose modifier; bar.warp.sync 0xffffffff before slot reuse; registers accumulated into checksum",
    "shuffle_input": "uint32(seed+17*lane+131*stream+8191*warp)",
    "shuffle_reference": "at each step all lanes simultaneously read source lane (lane+1)%32; same independent recurrence per stream",
    "timing": "initialization -> CTA barrier -> thread0 saves ns/cycles -> CTA barrier -> loop -> value-dependent result drain and CTA barrier -> stop ns/cycles; output copy outside interval",
    "store_completion": "final CTA barrier establishes shared writes visible before stop; host full-array readback after kernel",
    "work_matrix": "iterations*8*matrices*128 bytes per enabled direction; roundtrip sums read+write and records each separately",
    "work_shuffle": "iterations*8*streams*(threads/32) warp instructions; not 32x lane instructions; read/write payload zero",
    "validation": "each process full nonuniform values; short 1/2 matrix iterations and shuffle steps1/3/33; no conversion/roundtrip-halving claims",
    "sass": "actual matrix/shuffle op remains inside timed backedge; direction,width,count checked per specialization; reject unexpected timed LDS/STS replacing intended matrix operation; record checksum and barrier instructions as overhead",
    "acceptance": "CPU pack/unpack and corrupted-coordinate rejection, target compile, numerical GPU preflight, independent B, then10 processes with bounded warmup and at most3batches",
    "limits": "controlled loop service includes address and checksum/dependency/sync overhead; no bare instruction latency; roundtrip time never divided by2",
    "sources": [
      "https://docs.nvidia.com/cuda/archive/12.9.1/parallel-thread-execution/index.html#warp-level-matrix-instructions-ldmatrix",
      "https://docs.nvidia.com/cuda/archive/12.9.1/parallel-thread-execution/index.html#warp-level-matrix-instructions-stmatrix",
      "https://docs.nvidia.com/cuda/archive/12.9.1/parallel-thread-execution/index.html#data-movement-and-conversion-instructions-shfl-sync"
    ]
  },
