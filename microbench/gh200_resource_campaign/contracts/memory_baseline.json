  "reference_run": "20261001-memory-c",
  "protocol": "contracts/protocol.json",
  "correctness": {
    "shared_read": "all eight scalar loads enter per-thread checksum; independently evaluate addresses on host",
    "shared_write": "initialize poison; compare checksum of actually written disjoint region on host",
    "global_read": "all uint4 lanes used; host formula checks each thread checksum",
    "global_write": "separate untimed full-array validation kernel",
    "global_duplex": "both full-array write check and read checksum",
    "empty": "zero workload; validate timestamps and CTA record coverage only"
  },
  "formulas": {
    "shared_scalar8": "threads * 8 scalar accesses * 4 bytes * iterations * blocks; direction by mode",
    "global_vector16": "quantum=blocks*threads*16; allocation=ceil(requested_bytes/quantum)*quantum; reads/writes=allocation*iterations for enabled directions",
    "empty_window": "work=read=write=0; primary output is complete grid timer envelope, never subtract from measured payload windows"
  },
  "warmup": "8 to 30 same-allocation windows, last 5 CV<=0.02; all timing samples retained, no thermal-equilibrium assertion",
  "timing": "CTA globaltimer and local clock64; end CTA barrier; global stores include device fence; data initialization and result copies/validation excluded",
  "sass_contracts": [
    {
      "function": "shared_pathILb0",
      "loop_token": "LDS",
      "count_per_unrolled_body": 8
    },
    {
      "function": "shared_pathILb1",
      "loop_token": "STS",
      "count_per_unrolled_body": 8
    },
    {
      "function": "global_path",
      "loop_tokens": [
        "LDG",
        "STG"
      ],
      "note": "predication selects mode; function contains both; each timed loop retains paths"
    }
  ],
  "claims": {
    "cache_residency_proven": false,
    "physical_hbm_bytes_proven": false,
    "bare_instruction_latency": false
  },
  "ncu": {
    "case": "global_read_cg_256m",
    "target_kernel": "global_path",
    "metrics": [
      "dram__bytes_read.sum",
      "dram__bytes_write.sum"
    ],
    "failure_policy": "permission denial is evidence gap; target timing remains independently audited"
  },
