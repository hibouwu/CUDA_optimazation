  "formulas": {
    "direction_bytes": "blocks*threads*8*access_bytes*iterations for each enabled direction",
    "address": "W=access_bytes/4; regular word base=((tid+q*256)*stride*W)&8191; broadcast base=(tid/32)*8+q (scalar only)",
    "unique_addresses": "derive by enumerating all tid/q/lane word indices for one iteration; do not multiply distinct address count into requested payload again"
  },
  "correctness": {
    "read": "all loaded components contribute to checksum; host enumerates addresses, widths and uint32 arithmetic independently",
    "write": "all written words compared post-timer against address/seed-derived values; poison initialized",
    "duplex": "distinct input/output arrays; stores computed solely from indices/seed, never loaded data; validate both paths",
    "broadcast": "read-only; every lane consumes data; no same-address concurrent writes"
  },
  "timing": "all threads prepared; recorded start then CTA barrier; counted access loops; end CTA barrier then stop; result validation/copy excluded",
  "storage": "two 8192-word arrays, 64 KiB/CTA, even for read/write controls; initialization excluded",
  "sass_contracts": {
    "requirements": "family B binds exact kernel symbols and timed loop LDS/STS counts by scalar/vector width; PTX volatile does not replace SASS verification"
  },
  "claims": {
    "cache_residency_proven": false,
    "physical_hbm_bytes_proven": false,
    "physical_smem_upper_bound": false,
    "bare_latency": false
  }
}
