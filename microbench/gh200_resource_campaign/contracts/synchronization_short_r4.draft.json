  "semantics": {
    "work": "warp points count logical PTX phases after compilation, WARPSYNC=0 and not exportable; CTA/mbarrier remain one collective phase; fence remains warp issue count; no thread multiplication",
    "mbarrier": "8-byte aligned shared object; thread0 initializes expected arrivals=CTA threads, CTA barrier before use; every thread arrives once and waits with its returned opaque state; bounded polling; invalidate only after all final waits and CTA barrier",
    "mbarrier_polling": "record each thread total wait attempts and timeout flag; attempts are not known instruction work_count; loop bookkeeping part of service",
    "skew_work": "selected participants run256 volatile dependent mad.lo.u32 x=1664525*x+1013904223 modulo2^32 before every phase; unselected perform0; host checks each final x",
    "arrival_diagnostic": "separate untimed correctness launch records per-thread same-SM clock64 before/after one synchronization and delay values; actual arrival spread reported; intended skew alone is not evidence of observed skew",
    "formal_overhead": "do not put per-phase timestamp arrays in formal loop; one CTA start/end and final result drain only; fixed-work skew metric includes computation and waiting; never subtract aligned median and call difference intrinsic barrier cost; mbarrier internal timeout clock reads are retained service bookkeeping, not additional measurement boundaries.",
    "timing": "initialization -> barrier0 -> thread0 start -> barrier0 -> loop -> final per-thread output drain/barrier0 -> stop; timed CTA rendezvous uses barrier1",
    "correctness": "separate phase-token producer/consumer validation: store unique seed/thread/phase value, target synchronization, read neighbor in participating group, second target synchronization before next overwrite; all elements checked; fence correctness uses explicit consumer synchronization outside issue-only timing",
    "fence_limit": "issue-only under no prior outstanding work; final CTA barrier is explicit, fence itself is not completion proof of cp.async/TMA/WGMMA; no general ordering proof from timing",
    "sass": "count actual warp/CTA/mbarrier/fence instructions in function scoped backedges, verify skew256 dependency instructions; initialized barrier operations outside timing; extra dynamic wait attempts recorded, not assumed one",
    "acceptance": "CPU recurrences and work count negatives; target compile and SASS; real finite-time numerical preflight; independent B before10-process formal batches",
    "sources": [
      "https://docs.nvidia.com/cuda/archive/12.9.1/parallel-thread-execution/index.html#parallel-synchronization-and-communication-instructions-bar-warp-sync",
      "https://docs.nvidia.com/cuda/archive/12.9.1/parallel-thread-execution/index.html#parallel-synchronization-and-communication-instructions-mbarrier",
      "https://docs.nvidia.com/cuda/archive/12.9.1/parallel-thread-execution/index.html#parallel-synchronization-and-communication-instructions-membar"
    ]
  },
