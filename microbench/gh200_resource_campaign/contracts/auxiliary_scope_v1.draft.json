  "integer_semantics": {
    "u32": "modulo 2^32",
    "u64": "modulo 2^64",
    "indices": "thread t, word/stream j, iteration i are zero-based",
    "I": "I(seed,t,j) = (seed + 65537*(t+1) + 257*(j+1)) mod 2^32"
  },
  "operations": {
    "capacity_and_local_and_pressure": {
      "initial_word": "I(seed,t,j)",
      "update": "x = (1664525*x + 1013904223) mod 2^32",
      "updates_per_iteration": "threads * words_per_thread (or live_u32_values)",
      "final_output": "all words, thread-major"
    },
    "add_u64": {
      "initial": "(uint64(I(seed,t,j)) << 32) | I(seed,t,j+17)",
      "increment": "((uint64(seed) << 32) + 65537*(t+1) + 257*(j+1)) | 1",
      "update": "x = (x + increment) mod 2^64",
      "target_requests_per_iteration": "threads * streams"
    },
    "mad_wide_u32": {
      "initial_x": "I(seed,t,j)",
      "a": "I(seed XOR 0xa5a5a5a5,t,j) | 1",
      "c": "(uint64(I(seed XOR 0x5a5a5a5a,t,j)) << 32) | I(seed XOR 0xc3c3c3c3,t,j)",
      "update": "r = (uint64(x)*uint64(a) + c) mod 2^64; x = low32(r)",
      "final_output": "full r for every stream",
      "target_requests_per_iteration": "threads * streams"
    },
    "conversion": {
      "initial_q": "I(seed,t,j) & 1023",
      "salt": "(I(seed XOR 0x9e3779b9,t,j) & 1023) | 1",
      "update_before_conversion": "q = (previous_q + salt + i) & 1023",
      "f32_input_bits": "0x3f800000 | (q << 13)",
      "f16_input_bits": "0x3c00 | q",
      "f32_to_f16_feedback": "previous_q = output_half_bits & 1023",
      "f16_to_f32_feedback": "previous_q = (output_float_bits >> 13) & 1023",
      "final_output": "all raw target output bit patterns",
      "target_requests_per_iteration": "threads * streams"
    },
    "atomic": {
      "initial": "I(seed,0,address_index), address_index=0 for same_word; t for per_thread_word",
      "increment": "1 + (t % 7)",
      "requests_per_iteration": "threads",
      "return_value": "unused",
      "memory_order": "relaxed",
      "global_scope": "gpu",
      "shared_scope": "cta",
      "output": "one u32 for same_word; threads u32 for per_thread_word",
      "completion": "CTA barrier after all atomic iterations, then final values copied to global, then CTA barrier before stop stamp"
    }
  },
  "dynamic_smem_lifecycle": {
    "initialization": "before start stamp: t writes j=t,t+threads,...<dynamic_smem_bytes/4 with I(seed,0,j), once per word; CTA barrier",
    "loop": "no SMEM payload access; only the declared register recurrence",
    "drain": "after stop stamp: t reads the same j sequence and writes every SMEM word to a separate global output; kernel completion and host copy validate it",
    "effective_loop_work": "zero additional dynamic-SMEM payload requests; setup/drain excluded from CTA timing",
    "final_resource_check": "requested dynamic SMEM must be present in actual launch/resource metadata"
  }
}
