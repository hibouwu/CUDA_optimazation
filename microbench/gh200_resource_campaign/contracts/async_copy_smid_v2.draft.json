  "sass_contracts": {
    "requirements": "B binds actual copy instruction width/cache hint, commit and wait lowering, finite loop and drain, source/destination address domains and active128 threads; reject hoisted copies or missing waits/CTA synchronization; do not assume cp.async commit group equals a physical queue entry"
  },
  "pipeline": {
    "total_copy_steps_per_thread": "iterations*8",
    "source_byte_offset": "((block_id*128+thread_id+step*grid_blocks*128)*request_bytes) modulo global_array_bytes",
    "source_footprint": "one shared8MiB read-only GMEM array for whole launch; no per-CTA8MiB allocation; cache state unproven",
    "destination_byte_offset": "(step modulo stages)*128*request_bytes + thread_id*request_bytes",
    "prefill": "issue min(stages,total_steps) copies, each followed by commit_group per thread, inside timed window",
    "consume": "for step i, wait_group min(stages-1,total_steps-i-1); use literal0/1/2/3 branch as required; CTA barrier after each producer waits, then consume neighbor thread full payload and CTA barrier before reuse",
    "refill": "after consume and release barrier, if i+stages<total_steps issue copy i+stages into released slot and commit; never overwrite an unconsumed slot",
    "drain": "final wait_group0 plus CTA barrier and result-dependent drain before stop; no uncommitted requests remain",
    "tail": "remaining pending groups decrease near end; must lower wait immediate with tail, never use fixed stages-1 after refill stops",
    "timing": "init and poison outside timer; thread0 start then CTA gate; prefill/mainloop/tail/drain all timed; stop before host/readback output",
    "work": "Q=blocks*128*iterations*8*request_bytes; primary work_count=Q (transport payload once), GMEM read_payload_bytes=Q, SMEM write_payload_bytes=Q; consumer_read_bytes=Q recorded separately, do not add into transport payload",
    "correctness": "short full-case validate-only lengths1/2 iterations plus final-stage snapshots; all payload words checked, including cross-thread consumption; formal checksum unsigned modular host oracle; source can be shared across CTAs because read-only",
    "short_validation_priority": "all24 cases pass short correctness before any calibration or formal warmup; family contains fixed iteration policy; retain10 processes and bounded warmup formal protocol",
    "constraints": "source/dest fit aligned domains, no overlapping destinations within a group; old stage consumption completes before reuse; clamp grid to actual occupancy and reject infeasible shared memory",
    "limits": "measures controlled copy+commit/wait+cross-thread-consume+barrier service, not isolated issue latency or physical HBM bandwidth; ca/cg are requested cache policies, not cache-hit proof",
    "sources": [
      "https://docs.nvidia.com/cuda/archive/12.9.1/parallel-thread-execution/index.html#data-movement-and-conversion-instructions-cp-async",
      "https://docs.nvidia.com/cuda/archive/12.9.1/parallel-thread-execution/index.html#data-movement-and-conversion-instructions-cp-async-wait-group-cp-async-wait-all"
    ]
  }
