{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sm110a-static-instance-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_sha256", "objective_sha256", "freshness_epoch",
    "instance_id", "subject", "provenance", "target", "translation_units",
    "declared_config", "static_contract", "hypothesis"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "objective_sha256": {"$ref": "#/$defs/sha256"},
    "freshness_epoch": {"type": "string", "minLength": 1},
    "instance_id": {"$ref": "#/$defs/safe_id"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "group"],
      "properties": {
        "kind": {"enum": ["explicit_schedule_tag", "kernel_schedule_auto_control"]},
        "id": {"type": "string", "minLength": 1},
        "group": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_inventory_sha256", "reference_class", "source_anchors", "parent_instance_id", "derivation_axis"],
      "properties": {
        "reference_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "reference_class": {"enum": ["official_cpp_explicit_or_conditional", "official_cpp_auto_derived", "generator_config", "source_derived", "auto_control"]},
        "source_anchors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_anchor"}},
        "parent_instance_id": {"type": ["string", "null"]},
        "derivation_axis": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["cutlass_git_sha", "cutlass_arch_tag", "virtual_arch", "binary_arch"],
      "properties": {
        "cutlass_git_sha": {"pattern": "^[0-9a-f]{40}$"},
        "cutlass_arch_tag": {"const": "cutlass::arch::Sm100"},
        "virtual_arch": {"const": "compute_110a"},
        "binary_arch": {"const": "sm_110a"}
      }
    },
    "translation_units": {
      "type": "object", "additionalProperties": false,
      "required": ["config", "kernel", "type_witness", "collective_prefix_witness"],
      "properties": {
        "config": {"$ref": "#/$defs/file_ref"},
        "kernel": {"$ref": "#/$defs/file_ref"},
        "type_witness": {"$ref": "#/$defs/file_ref"},
        "collective_prefix_witness": {
          "oneOf": [{"$ref": "#/$defs/file_ref"}, {"type": "null"}]
        }
      }
    },
    "declared_config": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "operator_class", "elements", "layouts", "alignments", "builder_contract", "mma_tile_mnk", "cluster_mnk", "stage_policy", "mainloop_schedule", "epilogue_schedule", "kernel_problem_shape", "tile_scheduler", "cta_group", "mechanism"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "operator_class": {"type": "string", "minLength": 1},
        "elements": {"type": "object", "additionalProperties": false, "required": ["a", "b", "c", "d", "accumulator", "compute"], "properties": {"a": {"type": "string", "minLength": 1}, "b": {"type": "string", "minLength": 1}, "c": {"type": "string", "minLength": 1}, "d": {"type": "string", "minLength": 1}, "accumulator": {"type": "string", "minLength": 1}, "compute": {"type": "string", "minLength": 1}}},
        "layouts": {"type": "object", "additionalProperties": false, "required": ["a", "b", "c", "d"], "properties": {"a": {"type": "string", "minLength": 1}, "b": {"type": "string", "minLength": 1}, "c": {"type": "string", "minLength": 1}, "d": {"type": "string", "minLength": 1}}},
        "alignments": {"type": "object", "additionalProperties": false, "required": ["a", "b", "c", "d"], "properties": {"a": {"type": "integer", "minimum": 1}, "b": {"type": "integer", "minimum": 1}, "c": {"type": "integer", "minimum": 1}, "d": {"type": "integer", "minimum": 1}}},
        "builder_contract": {
          "type": "object", "additionalProperties": false,
          "required": ["mainloop_operator_class", "epilogue_operator_class", "element_a", "element_b", "layout_a", "layout_b", "epilogue_element_c", "epilogue_element_d", "epilogue_layout_c", "epilogue_layout_d", "epilogue_tile", "fusion_operation", "problem_mode", "cluster_type_cpp", "cluster_is_dynamic", "cluster_default_mnk"],
          "properties": {
            "mainloop_operator_class": {"type": "string", "minLength": 1}, "epilogue_operator_class": {"type": "string", "minLength": 1},
            "element_a": {"type": "string", "minLength": 1}, "element_b": {"type": "string", "minLength": 1},
            "layout_a": {"type": "string", "minLength": 1}, "layout_b": {"type": "string", "minLength": 1},
            "epilogue_element_c": {"type": "string", "minLength": 1}, "epilogue_element_d": {"type": "string", "minLength": 1},
            "epilogue_layout_c": {"type": "string", "minLength": 1}, "epilogue_layout_d": {"type": "string", "minLength": 1},
            "epilogue_tile": {"type": "string", "minLength": 1}, "fusion_operation": {"type": "string", "minLength": 1},
            "problem_mode": {"enum": ["dense", "array", "grouped", "moe"]},
            "cluster_type_cpp": {"type": "string", "minLength": 1}, "cluster_is_dynamic": {"type": "boolean"},
            "cluster_default_mnk": {"$ref": "#/$defs/shape3"}
          }
        },
        "mma_tile_mnk": {"$ref": "#/$defs/shape3"},
        "cluster_mnk": {"$ref": "#/$defs/shape3"},
        "stage_policy": {"type": "string", "minLength": 1},
        "mainloop_schedule": {"type": "string", "minLength": 1},
        "epilogue_schedule": {"type": "string", "minLength": 1},
        "kernel_problem_shape": {"type": "string", "minLength": 1},
        "tile_scheduler": {"type": "string", "minLength": 1},
        "cta_group": {"enum": [1, 2]},
        "mechanism": {
          "type": "object", "additionalProperties": false,
          "required": ["pointer_mode", "transforms", "block_scaled", "blockwise", "sparse", "mixed_input", "fast_fp32", "complex"],
          "properties": {
            "pointer_mode": {"enum": ["single", "array"]},
            "transforms": {"type": "object", "additionalProperties": false, "required": ["a", "b"], "properties": {"a": {"type": "string"}, "b": {"type": "string"}}},
            "block_scaled": {"type": "object", "additionalProperties": false, "required": ["enabled", "scale_a", "scale_b", "vector_size_a", "vector_size_b"], "properties": {"enabled": {"type": "boolean"}, "scale_a": {"type": ["string", "null"]}, "scale_b": {"type": ["string", "null"]}, "vector_size_a": {"type": ["integer", "null"], "minimum": 1}, "vector_size_b": {"type": ["integer", "null"], "minimum": 1}}},
            "blockwise": {"type": "object", "additionalProperties": false, "required": ["enabled", "granularity_m", "granularity_n", "granularity_k", "major_a", "major_b", "element_sfa", "element_sfb"], "properties": {"enabled": {"type": "boolean"}, "granularity_m": {"type": ["integer", "null"], "minimum": 1}, "granularity_n": {"type": ["integer", "null"], "minimum": 1}, "granularity_k": {"type": ["integer", "null"], "minimum": 1}, "major_a": {"enum": ["MN", "K", null]}, "major_b": {"enum": ["MN", "K", null]}, "element_sfa": {"type": ["string", "null"]}, "element_sfb": {"type": ["string", "null"]}}},
            "sparse": {"type": "object", "additionalProperties": false, "required": ["enabled", "metadata_element", "a_sparsity", "e_sparsity"], "properties": {"enabled": {"type": "boolean"}, "metadata_element": {"type": ["string", "null"]}, "a_sparsity": {"enum": [2, null]}, "e_sparsity": {"enum": [8, 16, null]}}},
            "mixed_input": {"type": "object", "additionalProperties": false, "required": ["enabled", "mode", "operands_swapped", "transformed_operand", "tuple_arity", "narrow_type", "wide_type", "scale_type", "zero_type"], "properties": {"enabled": {"type": "boolean"}, "mode": {"enum": ["convert_only", "scale_only", "scale_zero", null]}, "operands_swapped": {"type": ["boolean", "null"]}, "transformed_operand": {"enum": ["a", "b", null]}, "tuple_arity": {"type": ["integer", "null"], "minimum": 1}, "narrow_type": {"type": ["string", "null"]}, "wide_type": {"type": ["string", "null"]}, "scale_type": {"type": ["string", "null"]}, "zero_type": {"type": ["string", "null"]}}},
            "fast_fp32": {"type": "object", "additionalProperties": false, "required": ["enabled", "atom_model", "num_compute_matrices", "num_bands", "scaling_factor", "acc_promotion_interval"], "properties": {"enabled": {"type": "boolean"}, "atom_model": {"enum": ["9xBF16-smem", "9xBF16-no-smem", null]}, "num_compute_matrices": {"type": ["integer", "null"], "minimum": 1}, "num_bands": {"type": ["integer", "null"], "minimum": 1}, "scaling_factor": {"type": ["integer", "null"], "minimum": 0}, "acc_promotion_interval": {"type": ["integer", "null"], "minimum": 1}}},
            "complex": {"type": "object", "additionalProperties": false, "required": ["enabled", "representation"], "properties": {"enabled": {"type": "boolean"}, "representation": {"enum": ["planar", "interleaved", null]}}}
          }
        }
      }
    },
    "static_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["required_layers", "target_entity", "function_selector", "tma_cta_policy", "ptx", "sass"],
      "properties": {
        "required_layers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "target_entity": {"const": "cutlass::device_kernel<GemmKernel>"},
        "function_selector": {"const": "sole_ptx_entry_equals_sole_elf_sto_entry_equals_unique_nvdisasm_function"},
        "tma_cta_policy": {"enum": ["match_mma", "allow_single_cta_input_transform"]},
        "ptx": {"$ref": "#/$defs/opcode_contract"},
        "sass": {"$ref": "#/$defs/opcode_contract"}
      }
    },
    "hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_outcome", "failure_domain", "failure_layer", "diagnostic_patterns", "control_instance_id", "control_campaign_id", "guard_profile_id", "reject_contract"],
      "properties": {
        "expected_outcome": {"enum": ["STATIC_PASS", "EXPECTED_STATIC_REJECT", "UNSUPPORTED_SM110A", "UNKNOWN"]},
        "failure_domain": {"type": ["string", "null"]},
        "failure_layer": {"type": ["string", "null"]},
        "diagnostic_patterns": {"type": "array", "items": {"type": "string"}},
        "control_instance_id": {"type": ["string", "null"]},
        "control_campaign_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "guard_profile_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "reject_contract": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["step_id", "expected_returncode", "expected_error_count", "required_diagnostics", "source_constraints", "control_relation", "controlled_delta", "requires_collective_prefix_witness"],
              "properties": {
                "step_id": {"const": "compile_type_witness"},
                "expected_returncode": {"type": "integer", "minimum": 1, "maximum": 124},
                "expected_error_count": {"type": "integer", "minimum": 1},
                "required_diagnostics": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/pattern"}},
                "source_constraints": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/source_anchor"}},
                "control_relation": {"enum": ["parent", "sibling"]},
                "controlled_delta": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "requires_collective_prefix_witness": {"type": "boolean"}
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "safe_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "file_ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/safe_path"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "source_anchor": {"type": "object", "additionalProperties": false, "required": ["path", "line_start", "line_end", "sha256"], "properties": {"path": {"$ref": "#/$defs/safe_path"}, "line_start": {"type": "integer", "minimum": 1}, "line_end": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "shape3": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "minItems": 3, "maxItems": 3},
    "pattern": {"type": "object", "additionalProperties": false, "required": ["id", "regex", "min_count", "max_count"], "properties": {"id": {"$ref": "#/$defs/safe_id"}, "regex": {"type": "string", "minLength": 3}, "min_count": {"type": "integer", "minimum": 0}, "max_count": {"type": ["integer", "null"], "minimum": 0}}},
    "opcode_contract": {"type": "object", "additionalProperties": false, "required": ["required", "forbidden"], "properties": {"required": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pattern"}}, "forbidden": {"type": "array", "items": {"$ref": "#/$defs/pattern"}}}}
  }
}
