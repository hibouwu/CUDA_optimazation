{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sm110a-static-artifact-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_sha256", "artifact_manifest_id", "attempt_id", "instance_ref", "fingerprint_ref", "items", "archive_bundle"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_manifest_id": {"$ref": "#/$defs/safe_id"},
    "attempt_id": {"$ref": "#/$defs/safe_id"},
    "instance_ref": {"$ref": "#/$defs/ref"},
    "fingerprint_ref": {"$ref": "#/$defs/ref"},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "archive_bundle": {"type": "object", "additionalProperties": false, "required": ["path", "format", "sha256", "size_bytes"], "properties": {"path": {"$ref": "#/$defs/safe_path"}, "format": {"enum": ["directory-manifest", "tar"]}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "safe_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": {"id": {"$ref": "#/$defs/safe_id"}, "path": {"$ref": "#/$defs/safe_path"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "item": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "role", "path", "storage", "media_type", "sha256", "size_bytes", "producer_step_id", "parent_artifact_ids", "sealed"], "properties": {"artifact_id": {"$ref": "#/$defs/safe_id"}, "role": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/safe_path"}, "storage": {"enum": ["git_evidence", "ignored_archive"]}, "media_type": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}, "producer_step_id": {"$ref": "#/$defs/safe_id"}, "parent_artifact_ids": {"type": "array", "items": {"$ref": "#/$defs/safe_id"}}, "sealed": {"const": true}}}
  }
}
